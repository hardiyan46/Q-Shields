# ==============================================================================
# Q-Shields Environment Variables Example
# Salin file ini menjadi `.env` sebelum menjalankan Docker Compose:
#   cp .env.example .env
# JANGAN commit file `.env` berisi kredensial asli ke repositori Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# App & Security
# ------------------------------------------------------------------------------
APP_ENV=development
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_HEX_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ------------------------------------------------------------------------------
# PostgreSQL (Dibaca oleh postgres container & backend/app/database.py)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=qshields
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=qshields
DATABASE_URL=postgresql+psycopg2://qshields:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/qshields

# ------------------------------------------------------------------------------
# LLM / Ollama (100% Internal Network, Tanpa Cloud LLM Eksternal)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ------------------------------------------------------------------------------
# Wazuh Stack & Integration (Mock-First sebelum integrasi Wazuh Manager Live)
# ------------------------------------------------------------------------------
# Kredensial internal Wazuh Indexer & Wazuh Manager API (jangan isi nilai asli di .env.example)
# Catatan fresh install: image bawaan wazuh/wazuh-indexer:4.9.2 menggunakan password default `SecretPassword`
# pada internal_users.yml. Untuk produksi, rotasi password via `wazuh-passwords-tool.sh` / `securityadmin.sh`.
INDEXER_USERNAME=admin
INDEXER_PASSWORD=SecretPassword
API_USERNAME=wazuh-wui
API_PASSWORD=MyS3cr37P450r.*-

# Integrasi Backend Q-Shields <-> Wazuh Manager API
WAZUH_USE_MOCK=true
WAZUH_API_URL=https://wazuh.manager:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=MyS3cr37P450r.*-
WAZUH_VERIFY_SSL=false

# ------------------------------------------------------------------------------
# Domain Controller / LDAP (Autentikasi via ldap3 tanpa simpan password LDAP)
# ------------------------------------------------------------------------------
LDAP_ENABLED=false
LDAP_SERVER_URL=ldaps://dc01.corp.internal:636
LDAP_BIND_DN=CN=svc-qshields,OU=ServiceAccounts,DC=corp,DC=internal
LDAP_BIND_PASSWORD=CHANGE_ME_LDAP_SERVICE_PASSWORD
LDAP_BASE_DN=DC=corp,DC=internal
LDAP_USER_FILTER=(sAMAccountName={username})

# ------------------------------------------------------------------------------
# Initial Admin Seed (Akun Lokal Awal Saat Bootstrap)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_INITIAL_ADMIN_PASSWORD
INITIAL_ADMIN_EMAIL=secops-admin@corp.internal

# ------------------------------------------------------------------------------
# Frontend (Next.js App Router)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000